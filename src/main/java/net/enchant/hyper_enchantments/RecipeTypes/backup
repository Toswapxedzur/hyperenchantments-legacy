package net.enchant.hyper_enchantments.RecipeTypes;

import com.mojang.serialization.DataResult;
import com.mojang.serialization.MapCodec;
import com.mojang.serialization.codecs.RecordCodecBuilder;
import net.enchant.hyper_enchantments.AllRecipes;
import net.minecraft.core.HolderLookup;
import net.minecraft.core.NonNullList;
import net.minecraft.network.RegistryFriendlyByteBuf;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.crafting.*;
import net.minecraft.world.level.Level;

public class PedestalRecipe implements Recipe<PedestalRecipeInput> {
    public Ingredient getMainPedestalItem() {
        return mainPedestalItem;
    }

    public NonNullList<Ingredient> getSidePedestalItem() {
        return sidePedestalItem;
    }

    public ItemStack getOutput() {
        return output;
    }

    public Ingredient mainPedestalItem;
    public NonNullList<Ingredient> sidePedestalItem;
    public ItemStack output;

    public PedestalRecipe(Ingredient inputMainPedestalItem, NonNullList<Ingredient> inputSidePedestalItem, ItemStack output){
        this.mainPedestalItem = inputMainPedestalItem;
        this.sidePedestalItem = inputSidePedestalItem;
        this.output = output;
    }

    public PedestalRecipe(NonNullList<Ingredient> pedestalItem, ItemStack output){
        this.mainPedestalItem = pedestalItem.getFirst();
        this.sidePedestalItem = NonNullList.copyOf(pedestalItem.subList(1, pedestalItem.size()));
        this.output = output;
    }

    @Override
    public NonNullList<Ingredient> getIngredients() {
        NonNullList<Ingredient> list = NonNullList.create();
        list.add(mainPedestalItem);
        list.addAll(sidePedestalItem);
        return list;
    }

    @Override
    public boolean matches(PedestalRecipeInput input, Level level) {
        if (level.isClientSide)
            return false;
        boolean match = true;
        match &= mainPedestalItem.test(input.mainPedestal);
        for(int i = 0; i < 8; i++){
            if(sidePedestalItem.size() > i){
                match &= sidePedestalItem.get(i).test(input.getItem(i+1));
            }else{
                match &= input.getItem(i+1).isEmpty();
            }
        }
        return match;
    }

    @Override
    public ItemStack assemble(PedestalRecipeInput input, HolderLookup.Provider provider) {
        return output.copy();
    }

    @Override
    public boolean canCraftInDimensions(int i, int i1) {
        return true;
    }

    @Override
    public ItemStack getResultItem(HolderLookup.Provider provider) {
        return output;
    }

    @Override
    public RecipeSerializer<?> getSerializer() {
        return AllRecipes.Pedestal_recipe_serializer.get();
    }

    @Override
    public RecipeType<?> getType() {
        return AllRecipes.Pedestal_recipe.get();
    }

    public static class Serializer implements RecipeSerializer<PedestalRecipe>{
        public static final MapCodec<PedestalRecipe> CODEC = RecordCodecBuilder.mapCodec(instance -> instance.group(
                Ingredient.CODEC_NONEMPTY.fieldOf("mainIngredient").forGetter(PedestalRecipe::getMainPedestalItem),
                Ingredient.CODEC.listOf().fieldOf("sideIngredients").flatXmap(
                        list -> {
                            Ingredient[] aIngredient = list.toArray(Ingredient[]::new);
                            return DataResult.success(NonNullList.of(Ingredient.EMPTY, aIngredient));
                        },
                        DataResult::success
                ).forGetter(PedestalRecipe::getSidePedestalItem),
                ItemStack.CODEC.fieldOf("result").forGetter(PedestalRecipe::getOutput)
        ).apply(instance, PedestalRecipe::new));

        private static PedestalRecipe fromNetwork(RegistryFriendlyByteBuf buffer) {
            int i = buffer.readVarInt();
            Ingredient ingredient = Ingredient.CONTENTS_STREAM_CODEC.decode(buffer);
            NonNullList<Ingredient> nonnulllist = NonNullList.withSize(i, Ingredient.EMPTY);
            nonnulllist.replaceAll(p_319735_ -> Ingredient.CONTENTS_STREAM_CODEC.decode(buffer));
            ItemStack itemstack = ItemStack.STREAM_CODEC.decode(buffer);
            return new PedestalRecipe(ingredient, nonnulllist, itemstack);
        }

        private static void toNetwork(RegistryFriendlyByteBuf buffer, PedestalRecipe recipe) {
            buffer.writeVarInt(recipe.sidePedestalItem.size() + 1);

            Ingredient.CONTENTS_STREAM_CODEC.encode(buffer, recipe.mainPedestalItem);

            for (Ingredient ingredient : recipe.sidePedestalItem) {
                Ingredient.CONTENTS_STREAM_CODEC.encode(buffer, ingredient);
            }

            ItemStack.STREAM_CODEC.encode(buffer, recipe.output);
        }

        public static final StreamCodec<RegistryFriendlyByteBuf, PedestalRecipe> STREAM_CODEC =
                StreamCodec.of(PedestalRecipe.Serializer::toNetwork, PedestalRecipe.Serializer::fromNetwork);

        @Override
        public MapCodec<PedestalRecipe> codec() {
            return CODEC;
        }

        @Override
        public StreamCodec<RegistryFriendlyByteBuf, PedestalRecipe> streamCodec() {
            return STREAM_CODEC;
        }
    }
}


package net.enchant.hyper_enchantments.RecipeTypes;

import com.google.common.collect.Multiset;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.crafting.RecipeInput;

import java.util.List;

public class PedestalRecipeInput implements RecipeInput {
    public ItemStack mainPedestal;
    public List<ItemStack> sidePedestal;

    public PedestalRecipeInput(ItemStack mainPedestal, List<ItemStack> sidePedestal){
        this.mainPedestal = mainPedestal;
        this.sidePedestal = sidePedestal;
    }

    @Override
    public ItemStack getItem(int i) {
        if(i==0)
            return mainPedestal;
        else if(i-1<sidePedestal.size())
            return sidePedestal.get(i-1);
        else
            return ItemStack.EMPTY;
    }

    @Override
    public int size() { return (sidePedestal.size() + 1); }

    public boolean equals(Object obj) {
        if(this == obj)
            return true;
        if(!(obj instanceof PedestalRecipeInput input))
            return false;
        return ItemStack.matches(this.mainPedestal, input.mainPedestal) && ItemStack.listMatches(this.sidePedestal, input.sidePedestal);
    }
}
